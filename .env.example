# CopilotKit + Claude Agent SDK (TypeScript) test suite — environment
#
# There are TWO processes here, so there are two places these go:
#
#   backend/.env         read by the agent server (dotenv.config() reads it)
#   frontend/.env.local  read by Next.js at startup
#
# Copy the relevant block into each. Never commit the filled-in files.


# ── backend/.env — required ──────────────────────────────────────────────────

# Anthropic API key. The Claude Agent SDK spawns a CLI child process that reads
# this from the environment. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key


# ── backend/.env — optional ──────────────────────────────────────────────────

# The model every agent runs on. `claude-opus-4-8` is the value the Quickstart
# publishes and the default this repo ships.
# CLAUDE_MODEL=claude-opus-4-8

# Where the agent server listens. The frontend's default AGENT_URL assumes 8000,
# so change them together or not at all.
# AGENT_PORT=8000


# ── frontend/.env.local — optional ───────────────────────────────────────────

# Where the Next runtime forwards agent runs. Defaults to http://localhost:8000.
# Set it if the agent server is on another host, port, or container.
# AGENT_URL=http://localhost:8000

# ── frontend/.env.local — CopilotKit Intelligence (threads) ─────────────────

# Project key for CopilotKit Intelligence. This is what puts the runtime in
# Intelligence mode: /info starts reporting mode "intelligence" and the thread
# endpoints return real rows. Without it the runtime falls back to SSE with an
# in-memory runner — chat works everywhere, but nothing persists across a
# restart and the three Threads routes degrade.
#
# Server-side only. Never prefix it NEXT_PUBLIC_; that would ship it in the
# browser bundle. Free developer tier at https://copilotkit.ai
# INTELLIGENCE_API_KEY=

# A SEPARATE credential, and the one that unlocks the Threads Drawer UI.
# INTELLIGENCE_API_KEY authorizes the runtime; this advertises a license.
# /info reports `licenseStatus` off this token, and client-side feature UIs
# gate on that field — so without it the drawer shows its locked Upgrade view
# even while threads work perfectly. Set both.
# COPILOTKIT_LICENSE_TOKEN=

# The identity `identifyUser` reads off request headers, so threads are scoped
# per user. A real app resolves a verified session instead. Override these in a
# second browser profile to watch two thread lists diverge.
# NEXT_PUBLIC_DEMO_USER_ID=harness-local
# NEXT_PUBLIC_DEMO_USER_NAME=Harness User

# Origin the server-side /info probe on the Quickstart page calls back into.
# Only needed if the app is not on http://127.0.0.1:$PORT.
# NEXT_PUBLIC_SITE_ORIGIN=


# ── frontend/.env.local — optional ───────────────────────────────────────────

# Kill switch for the CopilotKit Inspector. Set to `off` and restart to disable
# it app-wide without editing code. It is otherwise on for localhost only.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off

# OpenAI key, used for exactly one thing: Whisper transcription on the /voice
# route. Claude answers the chat; the mic does not. Without this key every other
# route works normally, /voice still runs via its sample-audio button, and
# clicking the mic returns a clear error instead of a 500.
# OPENAI_API_KEY=sk-...
